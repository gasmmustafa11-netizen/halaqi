import { Request, Response } from 'express';
import mongoose from 'mongoose';
import Salon from '../models/Salon';
import User from '../models/User';
import Notification from '../models/Notification';

export const registerSalon = async (req: Request, res: Response) => {
  try {
    const applicantUserId = (req as any).user?.id || (req as any).user?._id;
    const { name, ownerName, type, city, district, addressDetails, phoneNumber } = req.body;

    // 1. حفظ الصالون
    const newSalon = new Salon({
      ownerUserId: applicantUserId,
      name,
      ownerName,
      type,
      city,
      district,
      addressDetails,
      phoneNumber,
      isApproved: false,
      isPublished: false
    });

    await newSalon.save();

    // 2. البحث عن الأدمن بأي صيغة ممكنة للـ Role
    let adminUsers = await User.find({
      : [
        { role: { : /admin/i } },
        { isSuperAdmin: true },
        { isAdmin: true }
      ]
    }).select('_id');

    // إذا لم يجد أدمن، يرسل الإشعار لكافة الحسابات لضمان وصوله لحسابك الحالي
    let targetAdminIds = adminUsers.map(a => a._id);
    if (targetAdminIds.length === 0) {
      const allUsers = await User.find().limit(5).select('_id');
      targetAdminIds = allUsers.map(u => u._id);
    }

    // 3. إنتاج مستندات الإشعار
    const notificationDocs = targetAdminIds.map(adminId => ({
      recipientId: new mongoose.Types.ObjectId(adminId.toString()),
      senderId: new mongoose.Types.ObjectId(applicantUserId ? applicantUserId.toString() : adminId.toString()),
      title: 'طلب انضمام صالون جديد 💈',
      message: `قدم صالون "${name}" طلباً جديداً للانضمام للمنصة.`,
      type: 'SALON_JOIN_REQUEST',
      salonId: newSalon._id,
      isRead: false
    }));

    await Notification.insertMany(notificationDocs);

    return res.status(201).json({
      success: true,
      message: 'تم تقديم طلب الانضمام بنجاح',
      data: newSalon
    });
  } catch (error) {
    console.error('[Halaqi Debug Error]:', error);
    return res.status(500).json({ success: false, message: 'خطأ أثناء حفظ الطلب' });
  }
};
